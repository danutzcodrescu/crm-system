{
  "name": "crm",
  "version": "0.15",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test:tooling": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:report": "playwright show-report",
    "smoke:serve": "tsx e2e/serve.ts",
    "package": "rimraf ./dist && pnpm typecheck && pnpm build",
    "build": "pnpm build:router && pnpm build-express",
    "build:router": "react-router build",
    "build-express": "tsc -p ./tsconfig-express.json && tsc-alias -p ./tsconfig-express.json",
    "dev": "env-cmd -f .env.local tsx --import ./instrumentation.server.mjs ./cmd/server.ts",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "node --import ./instrumentation.server.mjs ./dist/cmd/server.js",
    "start-local": "env-cmd -f .env.local node --import ./instrumentation.server.mjs ./dist/cmd/server.js",
    "typecheck": "concurrently pnpm:typecheck:app pnpm:typecheck:server",
    "typecheck:app": "react-router typegen && tsc",
    "typecheck:server": "tsc -p ./tsconfig-express.json --noEmit",
    "db:push": "env-cmd -f .env.local drizzle-kit push --config=drizzle-dev.config.ts ",
    "db:generate": "env-cmd -f .env.local drizzle-kit generate --config=drizzle-dev.config.ts ",
    "db:migrate": "env-cmd -f .env.local drizzle-kit migrate --config=drizzle-dev.config.ts ",
    "db:seed": "env-cmd -f .env.local tsx ./scripts/seed.ts",
    "db:replace": "env-cmd -f .env.local tsx ./scripts/replaceNames.ts",
    "db:consultation": "env-cmd -f .env.local tsx ./scripts/importInitialConsultationDates.ts",
    "build-image": "env-cmd -f .env.production tsx ./scripts/build.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@date-fns/utc": "^2.1.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@infisical/sdk": "^5.2.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@node-rs/argon2": "^2.2.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@react-hookz/web": "^26.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@remix-run/form-data-parser": "^1.1.0",
    "@sentry/react-router": "11.11.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@tanstack/react-table": "^9.3.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "googleapis": "^189.0.0",
    "helmet": "^8.3.0",
    "html-entities": "^2.6.0",
    "lodash-es": "^4.18.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-http-print": "^4.0.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "remix-utils": "^10.0.1",
    "sanitize-html": "^2.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8.5.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "testcontainers": "^12.2.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
